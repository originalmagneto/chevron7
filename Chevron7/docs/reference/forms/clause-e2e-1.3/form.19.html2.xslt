<xsl:template name="formatTimeTrimMinutes">
  <xsl:param name="time" />
        <xsl:variable name="timeString" select="string($time)" />
        
        <xsl:choose>
		  <xsl:when test="$timeString != '' and contains($timeString, 'Z')">
                
            <xsl:variable name="hours" select="number(substring($timeString, 1, 2))" />
            <xsl:variable name="minutes" select="number(substring($timeString, 4, 2))" /> 
            
            <xsl:value-of select="concat(format-number(hours, '00'), ':', format-number($minutes, '00'))" />
          </xsl:when>
          <xsl:otherwise>
            <xsl:value-of select="$timeString"></xsl:value-of>
          </xsl:otherwise>
        </xsl:choose>
</xsl:template>

<xsl:template name="formatToSkDateTime">
<xsl:param name="dateTime" />
        <xsl:variable name="dateTimeString" select="string($dateTime)" />
        
        <xsl:choose>
          <xsl:when test="$dateTimeString != '' and contains($dateTimeString, 'Z')">
                     
            <xsl:variable name="years" select="number(substring($dateTimeString, 1, 4))" />
            <xsl:variable name="months" select="number(substring($dateTimeString, 6, 2))" />
            <xsl:variable name="days" select="number(substring($dateTimeString, 9, 2))" />  
            <xsl:variable name="hours" select="number(substring($dateTimeString, 12, 2))" />  
            <xsl:variable name="minutes" select="number(substring($dateTimeString, 15, 2))" /> 

			<xsl:variable name="summerDay"> 
				<xsl:choose>
					<xsl:when test="$years = 2016">
					  <xsl:value-of select="27"/>
					</xsl:when>
					<xsl:when test="$years = 2017">
					  <xsl:value-of select="26"/>
					</xsl:when>
					<xsl:when test="$years = 2018">
					  <xsl:value-of select="25"/>
					</xsl:when>
					<xsl:when test="$years = 2019">
					  <xsl:value-of select="31"/>
					</xsl:when>
					<xsl:when test="$years = 2020">
					  <xsl:value-of select="29"/>
					</xsl:when>
					<xsl:when test="$years = 2021">
					  <xsl:value-of select="28"/>
					</xsl:when>
					<xsl:otherwise>
					  <xsl:value-of select="0"></xsl:value-of>
					</xsl:otherwise>
				</xsl:choose>
            </xsl:variable>

			<xsl:variable name="winterDay"> 
				<xsl:choose>
					<xsl:when test="$years = 2016">
					  <xsl:value-of select="30"/>
					</xsl:when>
					<xsl:when test="$years = 2017">
					  <xsl:value-of select="29"/>
					</xsl:when>
					<xsl:when test="$years = 2018">
					  <xsl:value-of select="28"/>
					</xsl:when>
					<xsl:when test="$years = 2019">
					  <xsl:value-of select="27"/>
					</xsl:when>
					<xsl:when test="$years = 2020">
					  <xsl:value-of select="25"/>
					</xsl:when>
					<xsl:when test="$years = 2021">
					  <xsl:value-of select="31"/>
					</xsl:when>
					<xsl:otherwise>
					  <xsl:value-of select="0"></xsl:value-of>
					</xsl:otherwise>
				</xsl:choose>
            </xsl:variable>

			<!--HODINY-->
              
            <xsl:variable name="newHours"> 
				<xsl:choose>
					<xsl:when test="$winterDay > 0 and $summerDay > 0 and (($months > 3 and $months &lt; 10) or ($months = 3 and (($days > $summerDay) or ($days = $summerDay and ($hours > 1 or ($hours = 1 and $minutes > 0))))) or ($months = 10 and (($days &lt; $winterDay) or ($days = $winterDay and $hours = 0))))">
					  <xsl:value-of select="$hours + 2"/>
					</xsl:when>
					<xsl:otherwise>
					  <xsl:value-of select="$hours + 1"></xsl:value-of>
					</xsl:otherwise>
				</xsl:choose>
            </xsl:variable>
           
            <xsl:variable name="cetHours"> 
              <xsl:choose>
                <xsl:when test="$newHours &lt; 0">
                  <xsl:value-of select="24 + $newHours"/>
                </xsl:when>
                <xsl:when test="$newHours > 23">
                  <xsl:value-of select="$newHours - 24"/>          
                </xsl:when>
                <xsl:otherwise>
                  <xsl:value-of select="$newHours"></xsl:value-of>
                </xsl:otherwise>
              </xsl:choose>
            </xsl:variable>
            
            <!--DNI-->

            <xsl:variable name="daysOfMonth">
              <xsl:choose>
                <xsl:when test="$months = '01' or $months = '03' or $months = '05' or $months = '07' or $months = '08' or $months = '10' or $months = '12'">
                  <xsl:value-of select="number('31')"/>
                </xsl:when>
               <xsl:otherwise>
                  <xsl:choose>
                    <xsl:when test="daysOfMonth != '02'">
                       <xsl:value-of select="number('30')"></xsl:value-of>            
                    </xsl:when>
                    <xsl:otherwise>
                      <xsl:choose>
                        <xsl:when test="($years mod 4 = 0) and (($years mod 100 != 0) or ($years mod 400 = 0))">
                          <xsl:value-of select="number('29')"></xsl:value-of>  
                        </xsl:when>
                        <xsl:otherwise>
                          <xsl:value-of select="number('28')"></xsl:value-of>  
                        </xsl:otherwise>
                      </xsl:choose>
                    </xsl:otherwise>
                   </xsl:choose>                
                </xsl:otherwise>
              </xsl:choose>
            </xsl:variable>
              
            <xsl:variable name="newDays"> 
              <xsl:choose>
                <xsl:when test="$newHours &lt; 0">
                  <xsl:value-of select="$days - 1"/>
                </xsl:when>
                <xsl:when test="$newHours > 23">
                   <xsl:value-of select="$days + 1"/>      
                </xsl:when>
                <xsl:otherwise>
                  <xsl:value-of select="$days"></xsl:value-of>
                </xsl:otherwise>
              </xsl:choose>
            </xsl:variable>
            
            <xsl:variable name="cetDays"> 
              <xsl:choose>
                <xsl:when test="$newDays &lt; 1">
                  <xsl:value-of select="$daysOfMonth + $newDays"/>
                </xsl:when>
                <xsl:when test="$newDays > $daysOfMonth">
                  <xsl:value-of select="$newDays - $daysOfMonth"/>          
                </xsl:when>
                <xsl:otherwise>
                  <xsl:value-of select="$newDays"></xsl:value-of>
                </xsl:otherwise>
              </xsl:choose>
            </xsl:variable>
            
            <!--MESIACE-->
            
            <xsl:variable name="newMonths"> 
              <xsl:choose>
                <xsl:when test="$newDays &lt; 1">
                  <xsl:value-of select="$months - 1"/>
                </xsl:when>
                <xsl:when test="$newDays > $daysOfMonth">
                   <xsl:value-of select="$months + 1"/>      
                </xsl:when>
                <xsl:otherwise>
                  <xsl:value-of select="$months"></xsl:value-of>
                </xsl:otherwise>
              </xsl:choose>
            </xsl:variable>
            
            <xsl:variable name="cetMonths"> 
              <xsl:choose>
                <xsl:when test="newMonths &lt; 1">
                  <xsl:value-of select="12 + $newMonths"/>
                </xsl:when>
                <xsl:when test="$newMonths > 12">
                  <xsl:value-of select="$newMonths - 12"/>          
                </xsl:when>
                <xsl:otherwise>
                  <xsl:value-of select="$newMonths"></xsl:value-of>
                </xsl:otherwise>
              </xsl:choose>
            </xsl:variable>     
            
            <!--ROKY-->
            
             <xsl:variable name="cetYears"> 
              <xsl:choose>
                 <xsl:when test="$newMonths &lt; 1">
                  <xsl:value-of select="$years - 1"/>
                </xsl:when>
                <xsl:when test="$newMonths > 12">
                  <xsl:value-of select="$years + 1"/>       
                </xsl:when>
                <xsl:otherwise>
                  <xsl:value-of select="$years"></xsl:value-of>
                </xsl:otherwise>
              </xsl:choose>
            </xsl:variable>
            
            <xsl:value-of select="concat(format-number($cetDays, '00'),'.',format-number($cetMonths, '00'),'.',format-number($cetYears, '0000'),' ',format-number($cetHours, '00'), ':', format-number($minutes, '00'))" />
          </xsl:when>
          <xsl:otherwise>
            <xsl:variable name="dateSubstring" select="substring($dateTime, 1, 10)" />
			<xsl:variable name="timeSubstring" select="substring($dateTime, 12, 8)" />
			<xsl:variable name="dateString">
			<xsl:choose>
			<xsl:when test="$dateSubstring != '' and string-length($dateSubstring)=10 and string(number(substring($dateSubstring, 1, 4))) != 'NaN' ">
			<xsl:value-of select="concat(substring($dateSubstring, 9, 2), '.', substring($dateSubstring, 6, 2), '.', substring($dateSubstring, 1, 4))" />
			</xsl:when>
			<xsl:otherwise>
			<xsl:value-of select="$dateSubstring"></xsl:value-of>
			</xsl:otherwise>
			</xsl:choose>
			</xsl:variable>
			<xsl:variable name="timeString">
			<xsl:if test="$timeSubstring != ''">
			<xsl:value-of select="substring($timeSubstring, 1, 5)" />
			</xsl:if>
			</xsl:variable>
			<xsl:value-of select="concat($dateString,' ',$timeString)"/>
          </xsl:otherwise>
        </xsl:choose>
</xsl:template>

<xsl:template name="formatToSkDate">
<xsl:param name="date" />
<xsl:variable name="dateString" select="string($date)" />
<xsl:choose>
<xsl:when test="$dateString != '' and string-length($dateString)>9 ">
<xsl:value-of select="concat(substring($dateString, 9, 2), '.', substring($dateString, 6, 2), '.', substring($dateString, 1, 4))" />
</xsl:when>
<xsl:otherwise>
<xsl:value-of select="$dateString"></xsl:value-of>
</xsl:otherwise>
</xsl:choose>
</xsl:template>
<xsl:template name="formatAnyUri">
<xsl:param name="anyUri" />
<xsl:variable name="anyUriString" select="string($anyUri)" />
<xsl:variable name="anyUriSubString">
<xsl:choose>
<xsl:when test="$anyUriString != '' and contains($anyUriString, 'mailto:') and contains($anyUriString, '@')">
<xsl:value-of select="substring($anyUriString, 8, string-length($anyUriString))" />
</xsl:when>
<xsl:when test="$anyUriString != '' and contains($anyUriString, 'http://')">
<xsl:value-of select="substring($anyUriString, 8, string-length($anyUriString))" />
</xsl:when>
<xsl:when test="$anyUriString != '' and contains($anyUriString, 'https://')">
<xsl:value-of select="substring($anyUriString, 9, string-length($anyUriString))" />
</xsl:when>
<xsl:otherwise>
<xsl:value-of select="$anyUriString"></xsl:value-of>
</xsl:otherwise>
</xsl:choose>
</xsl:variable>
<xsl:value-of select="$anyUriSubString"/>
</xsl:template>

<xsl:template name="string-replace-all">
<xsl:param name="text"/>
<xsl:param name="replace"/>
<xsl:param name="by"/>
<xsl:choose>
<xsl:when test="contains($text, $replace)">
<xsl:value-of select="substring-before($text,$replace)"/>
<xsl:value-of select="$by"/>
<xsl:call-template name="string-replace-all">
<xsl:with-param name="text" select="substring-after($text,$replace)"/>
<xsl:with-param name="replace" select="$replace"/>
<xsl:with-param name="by" select="$by" />
</xsl:call-template>
</xsl:when>
<xsl:otherwise>
<xsl:value-of select="$text"/>
</xsl:otherwise>
</xsl:choose>
</xsl:template>

<xsl:template name="booleanToSkString">
<xsl:param name="boolValue" />
<xsl:variable name="boolValueString" select="string($boolValue)" />
<xsl:choose>
<xsl:when test="$boolValueString = 'true' ">
<xsl:text>Áno</xsl:text>
</xsl:when>
<xsl:when test="$boolValueString = '1' ">
<xsl:text>Áno</xsl:text>
</xsl:when>
<xsl:when test="$boolValueString = 'false' ">
<xsl:text>Nie</xsl:text>
</xsl:when>
<xsl:when test="$boolValueString = '0' ">
<xsl:text>Nie</xsl:text>
</xsl:when>
<xsl:otherwise>
<xsl:value-of select="$boolValueString"></xsl:value-of>
</xsl:otherwise>
</xsl:choose>
</xsl:template>

