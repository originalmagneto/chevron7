            "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
            "skos": "http://www.w3.org/2004/02/skos/core#"
            },
            "@id": "http://schemas.gov.sk/form/50349287.ConversionRecordOfPaperToElectronicDocument_2021.sk/1.2/ConversionRecordOfPaperToElectronicDocument/PersonPerformingConversion/PersonData/PhysicalPerson"
            "@type": "pper:PhysicalPerson",
            "dct:references": "pper:PhysicalPerson"
            }
          </xs:appinfo></xs:annotation></xs:element><xs:element name="LegalSubject" type="LegalSubjectCType" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="sk">Oznacenie osoby vykonavajucej zarucenu konverziu.</xs:documentation><xs:appinfo>
