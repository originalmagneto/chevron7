            "@type": "lsub:LegalSubject",
            "dct:references": "lsub:LegalSubject"
            }
          </xs:appinfo></xs:annotation></xs:element><xs:element name="ID" type="IDCType" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="sk">Oznacenie identifikatora osoby vykonavajucej zarucenu konverziu.</xs:documentation></xs:annotation></xs:element></xs:sequence></xs:complexType><xs:complexType name="PhysicalPersonCType"><xs:sequence><xs:element name="PersonName" type="PersonNameCType" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="sk">Meno a priezvisko osoby vykonavajucej zarucenu konverziu.</xs:documentation><xs:appinfo>
