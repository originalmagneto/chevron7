            }
          </xs:appinfo></xs:annotation></xs:element></xs:sequence></xs:complexType><xs:complexType name="PersonNameCType"><xs:sequence><xs:element name="GivenName" type="StringMax255ReqType" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="sk">Uvadza sa meno fyzickej osoby, ktora zarucenu konverziu vykonala. Neuvadza sa pri automatizovanom spracovani zarucenej konverzie.</xs:documentation><xs:appinfo>
