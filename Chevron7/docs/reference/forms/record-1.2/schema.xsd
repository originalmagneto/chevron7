            "@type": "pper:PersonName",
            "dct:references": "pper:familyName"
            }
          </xs:appinfo></xs:annotation></xs:element></xs:sequence></xs:complexType><xs:complexType name="LegalSubjectCType"><xs:sequence><xs:element name="Name" type="StringMax255ReqType" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="sk">Uvadza sa nazov osoby, ktora je podla zakona opravnena na vykonanie zarucenej konverzie, vratane organizacnej zlozky, ak zarucenu konverziu vykonava organizacna zlozka.</xs:documentation><xs:appinfo>
