            }
          </xs:appinfo></xs:annotation></xs:element><xs:element name="FamilyName" type="StringMax255ReqType" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="sk">Uvadza sa priezvisko fyzickej osoby, ktora zarucenu konverziu vykonala. Neuvadza sa pri automatizovanom spracovani zarucenej konverzie.</xs:documentation><xs:appinfo>
